# shellcheck shell=bash
# shellcheck disable=SC2034
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Browser Use API Key
BROWSER_USE_API_KEY=your_browser_use_api_key_here

# Path to the Google Chrome executable
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux: /usr/bin/google-chrome
CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Base directory for Chrome User Data
# macOS: /Users/<yourname>/Library/Application Support/Google/Chrome
# Windows: %LOCALAPPDATA%\Google\Chrome\User Data
# Linux: ~/.config/google-chrome
CHROME_USER_DATA="/Users/yourname/Library/Application Support/Google/Chrome"

# Specific Chrome Profile to use (e.g., "Default", "Profile 1")
CHROME_PROFILE="Default"

# Browser Use API Key
BROWSER_USE_API_KEY=your_browser_use_api_key_here

# Notion API Key
NOTION_API_KEY=your_notion_api_key_here

# Notion Database ID (from your to-do list URL)
# URL format: https://notion.so/<workspace>/<database_id>?v=...
NOTION_DATABASE_ID=your_notion_database_id_here